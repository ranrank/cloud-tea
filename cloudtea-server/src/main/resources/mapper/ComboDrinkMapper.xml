<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cloudtea.mapper.ComboDrinkMapper">
    <insert id="insertBatch">
        insert into combo_drink (combo_id, drink_id, name, price, copies) VALUES
        <foreach collection="comboDrinkList" item="sd" separator=",">
            (#{sd.comboId}, #{sd.drinkId}, #{sd.name}, #{sd.price}, #{sd.copies})
        </foreach>
    </insert>
    <delete id="deleteByDrinkIds">
        delete from combo_drink where drink_id in
        <foreach collection="drinkIds" item="drinkId" open="(" close=")" separator=",">
            #{drinkId}
        </foreach>
    </delete>


    <select id="getComboIdsByDrinkId" resultType="java.lang.Long">
        select combo_id from combo_drink where drink_id in
        <foreach collection="drinkIds" item="drinkId" open="(" close=")" separator=",">
            #{drinkId}
        </foreach>
    </select>
</mapper>
# Environment variable reference. Spring Boot does not automatically load this file.
# Export these variables in your shell or configure them in your IDE before startup.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cloud_tea
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-your-local-database-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=10
JWT_ADMIN_SECRET=replace-with-a-random-admin-secret
JWT_USER_SECRET=replace-with-a-different-random-user-secret
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=your-bucket
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
WECHAT_APP_ID=replace-with-your-app-id
WECHAT_SECRET=replace-with-your-wechat-secret
BAIDU_MAP_AK=replace-with-your-map-key
